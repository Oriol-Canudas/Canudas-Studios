# Copy to .env.local for local `vercel dev`. Never commit the real file —
# .env* is already gitignored.

# Required for the Director's API route (api/director-respond.ts).
OPENAI_API_KEY=
# Optional — defaults to gpt-5.5 if unset. Must be a model that supports
# the Responses API's native web_search tool.
OPENAI_MODEL=
# Optional kill switch — set to "1" to force the Director endpoint to
# return 503 ai_unavailable without calling the API at all.
AI_DIRECTOR_RESPOND_DISABLED=

# Not wired into any code path yet (next build pass) — provisioned schema
# already exists at supabase/migrations/0001_init.sql, waiting on a real
# Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Not wired into any code path yet (voice I/O is the next build pass).
ELEVENLABS_API_KEY=
